# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ------------------------------------
# 1. DEPENDENCIES & CORE IGNORES
# ------------------------------------

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# ------------------------------------
# 2. NEXT.JS / BUILD ARTIFACTS (CRITICAL)
# ------------------------------------

# next.js build output, caches, and logs
# **This prevents the GitHub large file error (GH001)**
/.next/
/out/
/build

# ------------------------------------
# 3. ENVIRONMENT & DEPLOYMENT
# ------------------------------------

# env files (NEVER commit secrets or local environment variables)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel deployment files
.vercel

# ------------------------------------
# 4. MISC & DEBUG
# ------------------------------------

# misc OS files
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
# next-env.d.ts (Keep this commented out unless you want to exclude it)
# next-env.d.ts